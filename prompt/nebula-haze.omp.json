{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#414868",
    "template": "❯ "
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "git",
          "style": "plain",
          "background": "transparent",
          "foreground": "#8aabe6",
          "template": "{{ if and (ne .Env.TERMINAL_EMULATOR \"JetBrains-JediTerm\") (ne .Env.TERM_PROGRAM \"vscode\") }} 󰘬 {{ if gt (len .HEAD) 20 }}{{ trunc 20 .HEAD }}…{{ else }}{{ .HEAD }}{{ end }}{{ if gt .Ahead 0 }} <#7ec8a0>↑{{ .Ahead }}</>{{ end }}{{ if gt .Behind 0 }} <#e07891>↓{{ .Behind }}</>{{ end }}{{ if gt .Working.Changed 0 }} <#e0c97e>✱{{ .Working.Changed }}</>{{ end }}{{ if gt .Staging.Changed 0 }} <#7ec8a0>✚{{ .Staging.Changed }}</>{{ end }}{{ if gt .Working.Untracked 0 }} <#606480>?{{ .Working.Untracked }}</>{{ end }}{{ end }}",
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": false,
            "branch_icon": ""
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "background": "transparent",
          "foreground": "#6ec4b6",
          "template": ""
        },
        {
          "type": "shell",
          "style": "plain",
          "background": "#1c1d36",
          "foreground": "#6ec4b6",
          "template": " 󰝰"
        },
        {
          "type": "path",
          "style": "plain",
          "background": "#1c1d36",
          "foreground": "#6ec4b6",
          "template": " {{ .Path }}",
          "options": {
            "style": "agnoster_short",
            "folder_separator_icon": "/",
            "folder_separator_template": "<#6ec4b6>/</>",
            "folder_icon": "…",
            "max_depth": 4
          }
        },
        {
          "type": "node",
          "style": "plain",
          "background": "#1c1d36",
          "foreground": "#7ec8a0",
          "template": "  ·  <#606480>⬡</> {{ .Major }}.{{ .Minor }}"
        },
        {
          "type": "dotnet",
          "style": "plain",
          "background": "#1c1d36",
          "foreground": "#8aabe6",
          "template": "  ·  <#606480>●</> {{ .Major }}.{{ .Minor }}"
        },
        {
          "type": "text",
          "style": "plain",
          "background": "transparent",
          "foreground": "#9480c8",
          "template": " "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "background": "transparent",
          "foreground": "#9480c8",
          "template": "{{ if gt .Code 0 }}<#e07891>❯ {{ .Code }}</>{{ else }}<#9480c8>❯</>{{ end }}",
          "options": {
            "always_enabled": true
          }
        }
      ]
    }
  ]
}
